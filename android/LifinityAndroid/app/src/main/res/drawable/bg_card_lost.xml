<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão de tarefa PERDIDA: espelha o bg_card_clay (mesmos cantos 30dp) mas em
     coral muito claro, com uma borda coral mais marcada, para o cartão inteiro
     "chamar a atenção" a vermelho. Toda a informação da tarefa continua legível
     por cima (o coral é claro). Aplicado em runtime no TaskAdapter. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="#FCEAE5" />
    <corners android:radius="30dp" />
    <stroke android:width="1.5dp" android:color="@color/lifinity_coral" />
</shape>
