<?xml version="1.0" encoding="utf-8"?>
<!-- Botão secundário clay (tema claro): fundo branco com borda subtil e texto
     escuro. Recua perante o primário verde, mas continua a parecer um botão. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/lifinity_inset2" />
            <corners android:radius="@dimen/radius_control" />
            <stroke android:width="1dp" android:color="@color/lifinity_border" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/lifinity_surface" />
            <corners android:radius="@dimen/radius_control" />
            <stroke android:width="1dp" android:color="@color/lifinity_border" />
        </shape>
    </item>
</selector>
