<?xml version="1.0" encoding="utf-8"?>
<!-- Primeiro plano do ícone adaptativo: logo Lifinity completa, SEM tint.
     A logo (666x375, ~16:9) é colocada numa caixa de 64x36dp centrada nos
     108dp da viewport — dentro da "zona segura" (~66dp centrais) e com a
     proporção preservada (64/36 = 1.78, igual ao rácio da logo). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item
        android:left="22dp"
        android:top="36dp"
        android:right="22dp"
        android:bottom="36dp">
        <bitmap
            android:src="@drawable/lifinity_logo"
            android:gravity="fill" />
    </item>
</layer-list>
