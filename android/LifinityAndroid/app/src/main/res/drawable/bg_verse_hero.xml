<?xml version="1.0" encoding="utf-8"?>
<!-- Fundo do "banner" do versículo do dia: forma com cantos arredondados uniformes.
     Serve dois fins: (1) cor escura de fallback enquanto a imagem carrega; (2) fornece
     o OUTLINE arredondado para o FrameLayout recortar os filhos (imagem + overlay) via
     android:clipToOutline="true". Cantos uniformes garantem um recorte fiável (API 24+). -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="#16261C" />
    <corners android:radius="22dp" />
</shape>
