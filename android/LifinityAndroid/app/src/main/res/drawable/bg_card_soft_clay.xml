<?xml version="1.0" encoding="utf-8"?>
<!-- Sub-cartão / chip clay (tema claro): preenchimento menta-cinza muito claro
     com borda subtil, para se ler como um elemento "afundado/secundário" tanto
     sobre o fundo como sobre os cartões brancos. Raio 22dp. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/lifinity_surface2" />
    <corners android:radius="22dp" />
    <stroke android:width="1dp" android:color="@color/lifinity_border" />
</shape>
