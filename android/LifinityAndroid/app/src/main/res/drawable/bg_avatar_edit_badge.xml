<?xml version="1.0" encoding="utf-8"?>
<!-- Selo circular (verde da marca) com anel branco, para o botão "Mudar foto"
     sobreposto ao canto inferior direito do avatar. Estado pressionado escurece
     ligeiramente para dar feedback de toque. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="oval">
            <solid android:color="@color/lifinity_primary_dark" />
            <stroke android:width="2dp" android:color="@color/lifinity_surface" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/lifinity_primary" />
            <stroke android:width="2dp" android:color="@color/lifinity_surface" />
        </shape>
    </item>
</selector>
