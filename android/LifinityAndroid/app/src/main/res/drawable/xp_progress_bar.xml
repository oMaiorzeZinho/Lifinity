<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de progresso do nível com aspeto de "barra de XP" de jogo:
       - camada de fundo (track): pílula clara com contorno subtil (lê-se bem o vazio);
       - camada de progresso: pílula verde com leve gradiente (claro -> marca).
     Aplicada ao ProgressBar via android:progressDrawable. IMPORTANTE: o ProgressBar
     horizontal limita a altura do desenho pelo maxHeight, por isso o layout define
     android:maxHeight/minHeight = 16dp para a barra ficar encorpada (e não fina). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Track (fundo) -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <corners android:radius="999dp" />
            <solid android:color="@color/lifinity_inset" />
            <stroke
                android:width="1dp"
                android:color="@color/lifinity_border" />
        </shape>
    </item>

    <!-- Progresso (preenchimento) — recortado (clip) consoante o valor 0..100 -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <corners android:radius="999dp" />
                <gradient
                    android:angle="0"
                    android:startColor="@color/lifinity_primary_light"
                    android:endColor="@color/lifinity_primary" />
            </shape>
        </clip>
    </item>
</layer-list>
