<?xml version="1.0" encoding="utf-8"?>
<!-- Ecrã de arranque (splash) clássico via windowBackground (tema claro):
     fundo quase-branco da identidade com o símbolo Lifinity (ouroboros/infinito,
     ilustração escura) centrado — lê-se bem sobre o fundo claro.
     Abordagem sem Java e sem dependências — funciona em todas as versões. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <color android:color="@color/lifinity_bg" />
    </item>
    <item
        android:width="200dp"
        android:height="116dp"
        android:gravity="center">
        <bitmap
            android:src="@drawable/lifinity_logo"
            android:gravity="fill" />
    </item>
</layer-list>
