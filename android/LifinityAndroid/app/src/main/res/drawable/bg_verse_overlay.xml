<?xml version="1.0" encoding="utf-8"?>
<!-- Overlay escuro semi-transparente por cima da imagem do versículo do dia, para o
     texto branco se ler bem. Gradiente vertical: mais claro em cima, mais escuro em
     baixo (onde fica a referência), dando profundidade. Recortado pelo clipToOutline
     do FrameLayout, por isso não precisa de cantos próprios. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#59000000"
        android:centerColor="#73000000"
        android:endColor="#A6000000" />
</shape>
