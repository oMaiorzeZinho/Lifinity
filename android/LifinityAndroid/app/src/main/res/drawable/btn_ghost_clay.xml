<?xml version="1.0" encoding="utf-8"?>
<!-- Botão "ghost" (ação secundária discreta): sem preenchimento sólido nem elevação,
     apenas um contorno menta ténue. Recua perante o botão primário (clay preenchido),
     deixando claro qual é a ação principal de cada ecrã. Raio 16dp como os outros controlos. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressionado: leve preenchimento menta para dar feedback de toque -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#2274CF97" />
            <stroke android:width="1dp" android:color="#7774CF97" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <!-- Repouso: transparente + contorno menta ténue (parece um "link" com moldura) -->
    <item>
        <shape>
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#4D74CF97" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
</selector>
