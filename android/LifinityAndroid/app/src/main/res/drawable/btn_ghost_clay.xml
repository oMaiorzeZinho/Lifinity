<?xml version="1.0" encoding="utf-8"?>
<!-- Botão "ghost" (ação secundária discreta): sem preenchimento, apenas um
     contorno verde ténue sobre transparente, com texto verde. Recua perante o
     botão primário preenchido. Raio 16dp como os outros controlos. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Pressionado: leve preenchimento verde para feedback de toque -->
    <item android:state_pressed="true">
        <shape>
            <solid android:color="#1A1E9E57" />
            <stroke android:width="1dp" android:color="@color/lifinity_primary" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
    <!-- Repouso: transparente + contorno verde ténue -->
    <item>
        <shape>
            <solid android:color="#00000000" />
            <stroke android:width="1dp" android:color="#661E9E57" />
            <corners android:radius="@dimen/radius_control" />
        </shape>
    </item>
</selector>
