<?xml version="1.0" encoding="utf-8"?>
<!-- Cartão clay (tema claro): superfície branca, cantos bem arredondados (30dp)
     e uma borda hairline muito ténue para definir a aresta. A profundidade vem
     da elevação real da View (no tema claro a sombra de elevação já é visível),
     por isso o claymorphism aqui é discreto e elegante — sem relevo forte. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android">
    <solid android:color="@color/lifinity_surface" />
    <corners android:radius="30dp" />
    <stroke android:width="1dp" android:color="#EBF1ED" />
</shape>
