<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de amigo (ou resultado de pesquisa): avatar com inicial, nome + nível,
     e um botão de ação (Adicionar / Remover) cujo texto é definido no adapter. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_soft_clay"
    android:elevation="5dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Avatar circular com a inicial do username -->
    <TextView
        android:id="@+id/friendAvatarText"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_avatar_clay"
        android:gravity="center"
        android:textColor="@color/lifinity_text_on_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="A" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/friendUsernameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/lifinity_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="Ana Silva" />

        <TextView
            android:id="@+id/friendLevelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/lifinity_text_secondary"
            android:textSize="12sp"
            tools:text="Nível 5 · 2043 XP" />
    </LinearLayout>

    <Button
        android:id="@+id/friendActionButton"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/height_button_secondary"
        android:layout_marginStart="10dp"
        android:background="@drawable/btn_ghost_clay"
        android:minWidth="0dp"
        android:paddingStart="18dp"
        android:paddingEnd="18dp"
        android:text="Remover"
        android:textAllCaps="false"
        android:textColor="@color/lifinity_primary"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
