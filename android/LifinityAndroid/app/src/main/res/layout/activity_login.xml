<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_clay"
    android:fillViewport="true"
    tools:context=".LoginActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/space_screen">

        <!-- ===== HERO: wordmark da marca + lema ===== -->
        <!-- O utilizador achava a imagem da logo feia aqui; usamos o nome
             "Lifinity" estilizado em verde, mais elegante e arejado. -->
        <TextView
            style="@style/LifinityWordmark"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="16dp"
            android:text="Lifinity"
            android:textSize="44sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="28dp"
            android:letterSpacing="0.02"
            android:text="Organiza. Concentra-te. Evolui."
            android:textColor="@color/lifinity_text_secondary"
            android:textSize="14sp" />

        <!-- ===== CARTÃO DO FORMULÁRIO ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_clay"
            android:elevation="8dp"
            android:orientation="vertical"
            android:padding="@dimen/space_card_hero">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="Entrar na conta"
                android:textColor="@color/lifinity_text"
                android:textSize="@dimen/text_screen_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Bem-vindo de volta — acede com os teus dados."
                android:textColor="@color/lifinity_text_secondary"
                android:textSize="@dimen/text_subtitle" />

            <EditText
                android:id="@+id/emailInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_input"
                android:layout_marginTop="32dp"
                android:autofillHints="emailAddress"
                android:background="@drawable/bg_input_clay"
                android:hint="Email ou username"
                android:inputType="textEmailAddress"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/lifinity_text"
                android:textColorHint="@color/lifinity_text_faint"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/passwordInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_input"
                android:layout_marginTop="14dp"
                android:autofillHints="password"
                android:background="@drawable/bg_input_clay"
                android:hint="Palavra-passe"
                android:inputType="textPassword"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/lifinity_text"
                android:textColorHint="@color/lifinity_text_faint"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/errorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/lifinity_danger"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Erro ao iniciar sessao."
                tools:visibility="visible" />

            <Button
                android:id="@+id/loginButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginTop="24dp"
                android:background="@drawable/btn_primary_clay"
                android:elevation="6dp"
                android:text="Entrar"
                android:textAllCaps="false"
                android:textColor="@color/lifinity_text_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <!-- Ação secundária (discreta): contorno ghost, mais baixa e sem elevação,
                 para recuar perante o botão primário "Entrar". -->
            <Button
                android:id="@+id/createAccountButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button_secondary"
                android:layout_marginTop="12dp"
                android:background="@drawable/btn_ghost_clay"
                android:text="Criar conta"
                android:textAllCaps="false"
                android:textColor="@color/lifinity_primary"
                android:textSize="@dimen/text_body"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/progressBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:indeterminateTint="@color/lifinity_primary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
