<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de grupo: ícone, nome + nº de membros, badges (papel/trancado) e chevron.
     O clique abre o menu de ações do grupo (ver membros, código, sair, apagar...). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_soft_clay"
    android:clickable="true"
    android:elevation="5dp"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="16dp">

    <TextView
        android:layout_width="42dp"
        android:layout_height="42dp"
        android:background="@drawable/bg_pill_mint"
        android:gravity="center"
        android:text="&#128106;"
        android:textSize="20sp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/groupNameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/lifinity_text"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Grupo Sigma" />

        <TextView
            android:id="@+id/groupMetaText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/lifinity_text_secondary"
            android:textSize="12sp"
            tools:text="4 membros · Admin" />

        <!-- Linha de badges (papel de admin e/ou trancado) -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/groupRoleBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_pill_mint"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="ADMIN"
                android:textColor="@color/lifinity_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/groupLockedBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="6dp"
                android:background="@drawable/bg_pill_coral"
                android:paddingStart="10dp"
                android:paddingEnd="10dp"
                android:paddingTop="3dp"
                android:paddingBottom="3dp"
                android:text="&#128274; TRANCADO"
                android:textColor="@color/lifinity_text_on_primary"
                android:textSize="10sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:text="›"
        android:textColor="@color/lifinity_text_secondary"
        android:textSize="22sp"
        android:textStyle="bold" />
</LinearLayout>
