<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_clay"
    android:fillViewport="true"
    tools:context=".CreateTaskActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_screen">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_clay"
            android:elevation="10dp"
            android:orientation="vertical"
            android:padding="@dimen/space_card_hero">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Nova atividade"
                android:textColor="@color/lifinity_text"
                android:textSize="@dimen/text_screen_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Cria uma atividade simples para o Lifinity."
                android:textColor="@color/lifinity_text_secondary"
                android:textSize="@dimen/text_subtitle" />

            <EditText
                android:id="@+id/createTaskTitleInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_input"
                android:layout_marginTop="28dp"
                android:background="@drawable/bg_input_clay"
                android:hint="Titulo"
                android:inputType="textCapSentences"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/lifinity_input_text"
                android:textColorHint="@color/lifinity_input_hint"
                android:textSize="16sp" />

            <EditText
                android:id="@+id/createTaskDescriptionInput"
                android:layout_width="match_parent"
                android:layout_height="120dp"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_clay"
                android:gravity="top"
                android:hint="Descricao opcional"
                android:inputType="textMultiLine|textCapSentences"
                android:padding="18dp"
                android:textColor="@color/lifinity_input_text"
                android:textColorHint="@color/lifinity_input_hint"
                android:textSize="16sp" />

            <Spinner
                android:id="@+id/createTaskPrioritySpinner"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_input"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_clay"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

            <EditText
                android:id="@+id/createTaskDueDateInput"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_input"
                android:layout_marginTop="14dp"
                android:background="@drawable/bg_input_clay"
                android:hint="Data limite opcional: YYYY-MM-DDTHH:mm"
                android:inputType="text"
                android:paddingStart="18dp"
                android:paddingEnd="18dp"
                android:singleLine="true"
                android:textColor="@color/lifinity_input_text"
                android:textColorHint="@color/lifinity_input_hint"
                android:textSize="16sp" />

            <!-- ===== DESTINO (igual ao browser) =====
                 Por defeito "Só para mim"; permite escolher vários amigos e/ou grupos.
                 NÃO se usam <Button> (o tema converte-os em MaterialButton e estraga o
                 aspeto) — são LinearLayout/TextView clicáveis. As linhas de amigos/grupos
                 são criadas em runtime no CreateTaskActivity. O estado selecionado/não
                 (fundo + cor do texto) é aplicado em Java. -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:letterSpacing="0.13"
                android:text="DESTINO"
                android:textColor="@color/lifinity_text_secondary"
                android:textSize="11sp"
                android:textStyle="bold" />

            <!-- Só para mim (estado inicial = selecionado, definido em Java) -->
            <TextView
                android:id="@+id/createTaskOnlyMeButton"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_card_soft_clay"
                android:gravity="center"
                android:text="Só para mim"
                android:textColor="@color/lifinity_text"
                android:textSize="15sp"
                android:textStyle="bold" />

            <!-- Cabeçalho "Amigos" (clicável: mostra/esconde o contentor) -->
            <LinearLayout
                android:id="@+id/createTaskFriendsHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_clay"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/createTaskFriendsHeaderText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Amigos"
                    android:textColor="@color/lifinity_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/createTaskFriendsArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textColor="@color/lifinity_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Contentor de amigos (preenchido em Java; escondido por defeito) -->
            <LinearLayout
                android:id="@+id/createTaskFriendsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <!-- Cabeçalho "Grupos" (clicável: mostra/esconde o contentor) -->
            <LinearLayout
                android:id="@+id/createTaskGroupsHeader"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:layout_marginTop="12dp"
                android:background="@drawable/bg_input_clay"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp">

                <TextView
                    android:id="@+id/createTaskGroupsHeaderText"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Grupos"
                    android:textColor="@color/lifinity_text"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/createTaskGroupsArrow"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="▼"
                    android:textColor="@color/lifinity_text_secondary"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Contentor de grupos (preenchido em Java; escondido por defeito) -->
            <LinearLayout
                android:id="@+id/createTaskGroupsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical"
                android:visibility="gone" />

            <TextView
                android:id="@+id/createTaskErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center"
                android:textColor="@color/lifinity_danger"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Erro ao criar atividade."
                tools:visibility="visible" />

            <Button
                android:id="@+id/createTaskSubmitButton"
                android:layout_width="match_parent"
                android:layout_height="@dimen/height_button"
                android:layout_marginTop="20dp"
                android:background="@drawable/btn_primary_clay"
                android:elevation="8dp"
                android:text="Criar"
                android:textAllCaps="false"
                android:textColor="@color/lifinity_text_on_primary"
                android:textSize="16sp"
                android:textStyle="bold" />

            <ProgressBar
                android:id="@+id/createTaskProgressBar"
                style="?android:attr/progressBarStyleSmall"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="18dp"
                android:indeterminateTint="@color/lifinity_primary"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
