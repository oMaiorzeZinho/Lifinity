<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de navegação inferior clay com FAB central.
     Incluir no fundo de cada Activity principal.
     Definir android:tag="tasks|community|inspiration|profile" no root para
     que o Java saiba qual tab está ativa.

     ÍCONES (consistentes): cada tab usa um ImageView com um vector drawable da
     família Material (ic_nav_tasks/community/inspiration/profile) — antes eram
     caracteres/emojis misturados (☰, 👥 a cores, ✦, ○). O BottomNavHelper recolore
     os ícones por estado (setColorFilter) e mantém os rótulos por baixo.

     TAB PERFIL: em vez do ícone genérico, mostra a MINIATURA da foto de perfil
     (navTabProfileAvatar, carregada por AvatarLoader). Quando não há foto, fica o
     ícone "person" (navTabProfileIcon) por baixo — nunca vazio.

     FAB ROBUSTO: o contentor mede @dimen/nav_total_height (96dp = barra 70dp + 26dp
     de folga em cima). A barra está alinhada ao fundo e o FAB (64dp) ao topo, pelo
     que emerge ~26dp acima da barra MAS permanece sempre DENTRO dos limites do
     FrameLayout — nunca é cortado. IMPORTANTE: cada <include> deste layout TEM de
     fixar android:layout_height="@dimen/nav_total_height"; com wrap_content o
     FrameLayout colapsa para ~70dp e o FAB desaparece. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/nav_total_height"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Barra de fundo clay (branca), encostada ao fundo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nav_clay"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:paddingTop="6dp">

        <!-- Tab Atividades -->
        <LinearLayout
            android:id="@+id/navTabTasks"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/navTabTasksIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Tarefas"
                android:src="@drawable/ic_nav_tasks" />

            <TextView
                android:id="@+id/navTabTasksLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tarefas"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/lifinity_text_secondary" />
        </LinearLayout>

        <!-- Tab Comunidade -->
        <LinearLayout
            android:id="@+id/navTabCommunity"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/navTabCommunityIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Comunidade"
                android:src="@drawable/ic_nav_community" />

            <TextView
                android:id="@+id/navTabCommunityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Comunidade"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/lifinity_text_secondary" />
        </LinearLayout>

        <!-- Espaço para o FAB central -->
        <View
            android:layout_width="68dp"
            android:layout_height="match_parent" />

        <!-- Tab Inspiração -->
        <LinearLayout
            android:id="@+id/navTabInspiration"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <ImageView
                android:id="@+id/navTabInspirationIcon"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:contentDescription="Inspiração"
                android:src="@drawable/ic_nav_inspiration" />

            <TextView
                android:id="@+id/navTabInspirationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Inspiração"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/lifinity_text_secondary" />
        </LinearLayout>

        <!-- Tab Perfil (miniatura do avatar com fallback para o ícone "person") -->
        <LinearLayout
            android:id="@+id/navTabProfile"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <FrameLayout
                android:layout_width="24dp"
                android:layout_height="24dp">

                <!-- Fallback: ícone "person" (recolorido por estado). -->
                <ImageView
                    android:id="@+id/navTabProfileIcon"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Perfil"
                    android:src="@drawable/ic_nav_profile" />

                <!-- Foto real do utilizador por cima (circular via AvatarLoader);
                     fica GONE quando não há foto, deixando ver o ícone "person". -->
                <ImageView
                    android:id="@+id/navTabProfileAvatar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Foto de perfil"
                    android:scaleType="centerCrop"
                    android:visibility="gone" />
            </FrameLayout>

            <TextView
                android:id="@+id/navTabProfileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Perfil"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/lifinity_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- FAB central: alinhado ao topo do contentor de @dimen/nav_total_height; como a
         barra ocupa os 70dp de baixo, o FAB de 64dp emerge ~26dp acima dela, totalmente
         visível e centrado, com a sombra a aparecer (elevação alta). -->
    <Button
        android:id="@+id/navFab"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_fab_clay"
        android:elevation="16dp"
        android:text="+"
        android:textColor="@color/lifinity_text_on_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

</FrameLayout>
