<?xml version="1.0" encoding="utf-8"?>
<!-- Barra de navegação inferior clay com FAB central.
     Incluir no fundo de cada Activity principal.
     Definir android:tag="tasks|community|inspiration|profile" no root para
     que o Java saiba qual tab está ativa.

     FAB ROBUSTO: o contentor tem 96dp de altura e a barra (70dp) está alinhada
     ao fundo, deixando 26dp livres em cima. O FAB (64dp) fica alinhado ao topo,
     pelo que emerge ~26dp acima da barra MAS permanece sempre DENTRO dos limites
     do FrameLayout — não depende de margens negativas nem do clip dos pais, por
     isso nunca é cortado. clipChildren/clipToPadding="false" garantem a sombra. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="96dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Barra de fundo clay (branca), encostada ao fundo -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="70dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_nav_clay"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:paddingBottom="4dp"
        android:paddingTop="6dp">

        <!-- Tab Atividades -->
        <LinearLayout
            android:id="@+id/navTabTasks"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/navTabTasksIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#9776;"
                android:textSize="18sp"
                android:textColor="@color/lifinity_text_secondary" />

            <TextView
                android:id="@+id/navTabTasksLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Tarefas"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/lifinity_text_secondary" />
        </LinearLayout>

        <!-- Tab Comunidade -->
        <LinearLayout
            android:id="@+id/navTabCommunity"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/navTabCommunityIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#128101;"
                android:textSize="18sp"
                android:textColor="@color/lifinity_text_secondary" />

            <TextView
                android:id="@+id/navTabCommunityLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Comunidade"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/lifinity_text_secondary" />
        </LinearLayout>

        <!-- Espaço para o FAB central -->
        <View
            android:layout_width="68dp"
            android:layout_height="match_parent" />

        <!-- Tab Inspiração -->
        <LinearLayout
            android:id="@+id/navTabInspiration"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/navTabInspirationIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#10022;"
                android:textSize="18sp"
                android:textColor="@color/lifinity_text_secondary" />

            <TextView
                android:id="@+id/navTabInspirationLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Inspiração"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/lifinity_text_secondary" />
        </LinearLayout>

        <!-- Tab Perfil -->
        <LinearLayout
            android:id="@+id/navTabProfile"
            android:layout_width="0dp"
            android:layout_height="54dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="6dp">

            <TextView
                android:id="@+id/navTabProfileIcon"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="&#9711;"
                android:textSize="18sp"
                android:textColor="@color/lifinity_text_secondary" />

            <TextView
                android:id="@+id/navTabProfileLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Perfil"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/lifinity_text_secondary" />
        </LinearLayout>
    </LinearLayout>

    <!-- FAB central: alinhado ao topo do contentor de 96dp; como a barra ocupa
         os 70dp de baixo, o FAB de 64dp emerge ~26dp acima dela, totalmente
         visível e centrado, com a sombra a aparecer (elevação alta). -->
    <Button
        android:id="@+id/navFab"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:layout_gravity="top|center_horizontal"
        android:background="@drawable/bg_fab_clay"
        android:elevation="16dp"
        android:text="+"
        android:textColor="@color/lifinity_text_on_primary"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textAllCaps="false" />

</FrameLayout>
