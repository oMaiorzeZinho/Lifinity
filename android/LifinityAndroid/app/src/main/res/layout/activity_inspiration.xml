<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_clay"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical"
    tools:context=".InspirationActivity">

    <!-- ===== HEADER (marca + sino) =====
         Fundo OPACO + elevação (igual ao Perfil/Tarefas): sem isto, o conteúdo do
         NestedScrollView desenhava-se POR CIMA do cabeçalho e o título "Inspiração"
         colidia com o logo/wordmark. Agora o conteúdo desliza limpo por baixo. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/lifinity_bg"
        android:elevation="6dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- Símbolo Lifinity (ouroboros/infinito) — escuro, lê-se bem sobre o branco -->
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="30dp"
                android:adjustViewBounds="true"
                android:contentDescription="Lifinity"
                android:scaleType="fitCenter"
                android:src="@drawable/lifinity_logo" />

            <!-- Wordmark da marca ao lado do símbolo -->
            <TextView
                style="@style/LifinityWordmark"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Lifinity"
                android:textSize="20sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/headerNotificationBell"
            android:layout_width="@dimen/size_header_icon"
            android:layout_height="@dimen/size_header_icon"
            android:background="@drawable/bg_card_soft_clay"
            android:elevation="4dp"
            android:gravity="center"
            android:text="&#128276;"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- ===== CONTEÚDO SCROLLÁVEL ===== -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:paddingStart="20dp"
        android:paddingEnd="20dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Inspiração"
                android:textColor="@color/lifinity_text"
                android:textSize="@dimen/text_screen_title"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="4dp"
                android:text="Uma mensagem para fortalecer o teu dia."
                android:textColor="@color/lifinity_text_secondary"
                android:textSize="14sp" />

            <!-- Erro -->
            <TextView
                android:id="@+id/inspirationErrorText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_soft_clay"
                android:padding="14dp"
                android:textColor="@color/lifinity_danger"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Nao foi possivel carregar inspiracao."
                tools:visibility="visible" />

            <!-- Loading -->
            <ProgressBar
                android:id="@+id/inspirationProgressBar"
                style="?android:attr/progressBarStyleLarge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="24dp"
                android:indeterminateTint="@color/lifinity_primary"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- ===== CARTÃO DO VERSÍCULO ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/bg_card_clay"
                android:elevation="10dp"
                android:orientation="vertical">

                <!-- BANNER com imagem de fundo (como no browser): a imagem
                     (bible_banner) preenche em centerCrop, com um overlay escuro por
                     cima para o texto BRANCO se ler bem. O FrameLayout recorta os filhos
                     aos cantos arredondados via clipToOutline + @drawable/bg_verse_hero.
                     A imagem é só do versículo (o fundo geral da página mantém-se claro). -->
                <!-- ALTURA FIXA (300dp): a causa real da faixa gigante era o FrameLayout
                     em wrap_content com a ImageView de fundo em match_parent — a imagem
                     grande inflava a medição e esticava a faixa muito além do texto. Com
                     altura fixa, a ImageView preenche exatamente esta altura em centerCrop
                     e o texto fica por cima. Subiu para 300dp (+ texto do versículo um
                     pouco menor) para caberem versículos LONGOS como Jeremias 29:11
                     ("Porque eu bem sei os pensamentos...") sem cortar no fim. -->
                <FrameLayout
                    android:id="@+id/inspirationVerseHero"
                    android:layout_width="match_parent"
                    android:layout_height="300dp"
                    android:layout_margin="16dp"
                    android:background="@drawable/bg_verse_hero"
                    android:clipToOutline="true">

                    <!-- Imagem de fundo -->
                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Imagem de fundo do versículo"
                        android:scaleType="centerCrop"
                        android:src="@drawable/bible_banner" />

                    <!-- Overlay escuro para legibilidade -->
                    <View
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_verse_overlay" />

                    <!-- Conteúdo do versículo (texto branco sobre a imagem+overlay).
                         Padding mais compacto (16dp) para a faixa ficar mais baixa. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/inspirationCardModeText"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:letterSpacing="0.1"
                                android:text="Versículo do Dia"
                                android:textColor="#FFFFFF"
                                android:textSize="12sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/inspirationThemeText"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:background="@drawable/bg_pill_mint"
                                android:paddingStart="12dp"
                                android:paddingEnd="12dp"
                                android:paddingTop="5dp"
                                android:paddingBottom="5dp"
                                android:text="Geral"
                                android:textColor="@color/lifinity_primary"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Aspas decorativas (mais pequenas, para caber texto longo) -->
                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:lineSpacingMultiplier="0.4"
                            android:text="&#8220;"
                            android:textColor="#B3FFFFFF"
                            android:textSize="28sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/inspirationVerseText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:lineSpacingExtra="4dp"
                            android:shadowColor="#99000000"
                            android:shadowDx="0"
                            android:shadowDy="1"
                            android:shadowRadius="6"
                            android:text="A carregar versículo..."
                            android:textColor="#FFFFFF"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/inspirationReferenceText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:textColor="#F0FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="— João 3:16" />
                    </LinearLayout>
                </FrameLayout>

                <!-- AÇÕES (na zona clay, por baixo da imagem — legíveis sobre o cartão) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="20dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/favoriteVerseButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/height_button"
                            android:layout_weight="1"
                            android:background="@drawable/btn_primary_clay"
                            android:elevation="6dp"
                            android:text="♥ Guardar"
                            android:textAllCaps="false"
                            android:textColor="@color/lifinity_text_on_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <!-- Partilhar versículo para uma conversa existente (ícone vetorial). -->
                        <ImageView
                            android:id="@+id/shareVerseButton"
                            android:layout_width="52dp"
                            android:layout_height="@dimen/height_button"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/btn_secondary_clay"
                            android:clickable="true"
                            android:contentDescription="Partilhar versículo"
                            android:elevation="4dp"
                            android:focusable="true"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_share" />

                        <!-- Ícone de copiar: vector drawable ic_copy (dois retângulos
                             sobrepostos, o símbolo universal de copiar). Substituiu o emoji
                             de prancheta, que não representava bem "copiar". Mesmo estilo do
                             botão de partilhar ao lado (ImageView + btn_secondary_clay). -->
                        <ImageView
                            android:id="@+id/copyVerseButton"
                            android:layout_width="52dp"
                            android:layout_height="@dimen/height_button"
                            android:layout_marginStart="10dp"
                            android:background="@drawable/btn_secondary_clay"
                            android:clickable="true"
                            android:contentDescription="Copiar versículo"
                            android:elevation="4dp"
                            android:focusable="true"
                            android:padding="14dp"
                            android:scaleType="fitCenter"
                            android:src="@drawable/ic_copy" />
                    </LinearLayout>

                    <!-- Ações secundárias lado a lado e mais leves (ghost), para a secção
                         respirar em vez de empilhar botões pesados. O "♥ Guardar" acima
                         continua a ser a ação principal forte. Ids e onClick mantêm-se. -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/randomVerseButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/height_button_secondary"
                            android:layout_weight="1"
                            android:background="@drawable/btn_ghost_clay"
                            android:text="Aleatório"
                            android:textAllCaps="false"
                            android:textColor="@color/lifinity_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/dailyVerseButton"
                            android:layout_width="0dp"
                            android:layout_height="@dimen/height_button_secondary"
                            android:layout_marginStart="10dp"
                            android:layout_weight="1"
                            android:background="@drawable/btn_ghost_clay"
                            android:text="Diário"
                            android:textAllCaps="false"
                            android:textColor="@color/lifinity_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== FAVORITOS ===== -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_card_clay"
                android:elevation="10dp"
                android:orientation="vertical"
                android:padding="22dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="0.13"
                    android:text="FAVORITOS"
                    android:textColor="@color/lifinity_text_secondary"
                    android:textSize="11sp"
                    android:textStyle="bold" />

                <!-- Filtro por tema (Task 2): temas derivados DINAMICAMENTE dos favoritos.
                     Oculto quando não há temas nos favoritos. "Todos" mostra tudo. -->
                <LinearLayout
                    android:id="@+id/inspirationThemeFilterContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="vertical"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Filtrar por tema"
                        android:textColor="@color/lifinity_text_secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/height_button"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/bg_card_soft_clay"
                        android:elevation="4dp"
                        android:gravity="center_vertical">

                        <Spinner
                            android:id="@+id/inspirationFavoritesThemeSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@null"
                            android:paddingStart="16dp"
                            android:paddingEnd="16dp"
                            android:popupBackground="@drawable/bg_card_clay" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/inspirationFavoritesEmptyText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/bg_card_soft_clay"
                    android:gravity="center"
                    android:padding="18dp"
                    android:text="Ainda não tens versículos favoritos."
                    android:textColor="@color/lifinity_text_secondary"
                    android:textSize="14sp" />

                <LinearLayout
                    android:id="@+id/inspirationFavoritesContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="vertical" />
            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- ===== BARRA DE NAVEGAÇÃO INFERIOR ===== -->
    <include
        layout="@layout/nav_bottom"
        android:layout_width="match_parent"
        android:layout_height="@dimen/nav_total_height" />
</LinearLayout>
