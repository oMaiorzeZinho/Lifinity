<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de pedido de amizade recebido: avatar + nome/nível e dois botões
     redondos: aceitar (✓, primário) e recusar (✕, ghost). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_soft_clay"
    android:elevation="5dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <TextView
        android:id="@+id/requestAvatarText"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_avatar_clay"
        android:gravity="center"
        android:textColor="@color/lifinity_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        tools:text="J" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/requestUsernameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/lifinity_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="João" />

        <TextView
            android:id="@+id/requestLevelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Quer adicionar-te como amigo"
            android:textColor="@color/lifinity_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Aceitar -->
    <Button
        android:id="@+id/requestAcceptButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/btn_primary_clay"
        android:elevation="6dp"
        android:text="&#10003;"
        android:textAllCaps="false"
        android:textColor="@color/lifinity_text_on_primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Recusar -->
    <Button
        android:id="@+id/requestDeclineButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/btn_ghost_clay"
        android:text="&#10005;"
        android:textAllCaps="false"
        android:textColor="@color/lifinity_text_secondary"
        android:textSize="15sp"
        android:textStyle="bold" />
</LinearLayout>
