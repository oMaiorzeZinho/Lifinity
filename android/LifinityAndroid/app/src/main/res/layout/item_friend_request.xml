<?xml version="1.0" encoding="utf-8"?>
<!-- Linha de pedido de amizade recebido: avatar + nome/nível e dois botões
     redondos: aceitar (✓, primário) e recusar (✕, ghost). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="10dp"
    android:background="@drawable/bg_card_soft_clay"
    android:elevation="5dp"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <!-- Avatar: placeholder (círculo + inicial) com a FOTO real por cima quando existe -->
    <FrameLayout
        android:layout_width="44dp"
        android:layout_height="44dp">

        <TextView
            android:id="@+id/requestAvatarText"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_avatar_clay"
            android:gravity="center"
            android:textColor="@color/lifinity_primary"
            android:textSize="18sp"
            android:textStyle="bold"
            tools:text="J" />

        <ImageView
            android:id="@+id/requestAvatarImage"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:contentDescription="Avatar"
            android:scaleType="centerCrop"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/requestUsernameText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/lifinity_text"
            android:textSize="15sp"
            android:textStyle="bold"
            tools:text="João" />

        <TextView
            android:id="@+id/requestLevelText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Quer adicionar-te como amigo"
            android:textColor="@color/lifinity_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Aceitar (✓): ImageView com vector ic_check. NÃO é <Button> — o tema Material
         convertia-o em MaterialButton e o símbolo desaparecia (mesmo bug do FAB/•••). -->
    <ImageView
        android:id="@+id/requestAcceptButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/btn_primary_clay"
        android:clickable="true"
        android:contentDescription="Aceitar"
        android:elevation="6dp"
        android:focusable="true"
        android:padding="11dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_check" />

    <!-- Recusar (✕): ImageView com vector ic_close (mesmo motivo). -->
    <ImageView
        android:id="@+id/requestDeclineButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="8dp"
        android:background="@drawable/btn_ghost_clay"
        android:clickable="true"
        android:contentDescription="Recusar"
        android:focusable="true"
        android:padding="12dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_close" />
</LinearLayout>
