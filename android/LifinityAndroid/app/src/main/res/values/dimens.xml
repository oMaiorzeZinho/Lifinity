<?xml version="1.0" encoding="utf-8"?>
<!-- ============================================================
     Escala visual central do Lifinity (Android).
     Tudo o que é "tamanho" e "espaço" vive aqui para que os ecrãs
     fiquem coerentes (uma só mão a desenhar). Os layouts devem usar
     estes tokens em vez de valores soltos.
     ============================================================ -->
<resources>
    <!-- ===== Espaçamento — escala AMPLIADA (8 / 12 / 16 / 24 / 32) =====
         A queixa principal era "amontoado": esta escala mais generosa dá à app
         muito mais ar. Como quase tudo referencia estes tokens, propaga-se. -->
    <dimen name="space_xs">8dp</dimen>
    <dimen name="space_sm">12dp</dimen>
    <dimen name="space_md">16dp</dimen>
    <dimen name="space_lg">24dp</dimen>
    <dimen name="space_xl">32dp</dimen>

    <!-- Margem lateral de ecrã (consistente em toda a app) -->
    <dimen name="space_screen">22dp</dimen>
    <!-- Padding interior dos cartões clay grandes (hero/formulário) -->
    <dimen name="space_card_hero">28dp</dimen>
    <!-- Padding interior dos cartões clay padrão -->
    <dimen name="space_card">22dp</dimen>
    <!-- Folga vertical entre elementos da lista (cartões a respirar) -->
    <dimen name="space_gap">18dp</dimen>

    <!-- ===== Escala tipográfica (aplicar em vez de sp soltos) ===== -->
    <dimen name="text_screen_title">26sp</dimen>   <!-- título grande de ecrã/formulário -->
    <dimen name="text_toolbar_title">20sp</dimen>  <!-- título em barra com botão voltar -->
    <dimen name="text_card_title">20sp</dimen>     <!-- título dentro de cartão -->
    <dimen name="text_subtitle">14sp</dimen>       <!-- subtítulo/descrição sob o título -->
    <dimen name="text_body">15sp</dimen>           <!-- corpo de texto -->
    <dimen name="text_caption">13sp</dimen>        <!-- texto auxiliar/secundário -->
    <dimen name="text_label">11sp</dimen>          <!-- rótulos MAIÚSCULOS de secção -->

    <!-- ===== Raios clay — cartão 30dp, suave 22dp, controlo/input 16dp ===== -->
    <dimen name="radius_card">30dp</dimen>
    <dimen name="radius_card_soft">22dp</dimen>
    <dimen name="radius_control">16dp</dimen>
    <dimen name="radius_pill">999dp</dimen>

    <!-- ===== Alturas de controlos (alvos de toque >= 44dp) ===== -->
    <dimen name="height_button">52dp</dimen>            <!-- botão primário (ação principal) -->
    <dimen name="height_button_secondary">46dp</dimen>  <!-- botão secundário discreto (mais baixo) -->
    <dimen name="height_input">52dp</dimen>
    <dimen name="height_button_icon">48dp</dimen>

    <!-- Botão circular/quadrado de ícone nos cabeçalhos (sino, definições, voltar) -->
    <dimen name="size_header_icon">40dp</dimen>

    <!-- ===== Barra de navegação inferior =====
         Altura TOTAL do contentor do nav (barra 70dp + folga de 26dp em cima para o
         FAB emergir). Fonte ÚNICA: usada no nav_bottom.xml E em cada <include>. Se o
         <include> não fixar esta altura, o FrameLayout colapsa para wrap_content (~70dp)
         e o FAB deixa de aparecer acima da barra. -->
    <dimen name="nav_total_height">96dp</dimen>

    <!-- ===== Avatares ===== -->
    <dimen name="size_avatar_large">80dp</dimen>
    <dimen name="size_avatar_medium">48dp</dimen>
    <dimen name="size_avatar_small">40dp</dimen>
</resources>
